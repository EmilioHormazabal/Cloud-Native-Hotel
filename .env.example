# ============================================================================
# Cloud Native I (DSY1107) - Template de variables de entorno
# Este example se copia hacia ".env"
# NUNCA se sube ".env" con valores reales a Git
# ============================================================================

# --- Base de datos (MySQL local via docker-compose) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
# Por microservicio: h_usuario / h_reserva / h_servicio (override comun)
DB_NAME=h_usuario

# --- Puertos de cada microservicio ---
SERVER_PORT=8081
# reserva=8081, servicio=8082, usuario=8083, bff=8084

# --- BFF: destino de cada microservicio (solo si se corre el BFF contra microservicios locales) ---
# MICROSERVICIOS_USUARIO_URL=http://localhost:8083
# MICROSERVICIOS_RESERVA_URL=http://localhost:8081
# MICROSERVICIOS_SERVICIO_URL=http://localhost:8082

# --- Seguridad OAuth2 Resource Server (Azure Entra ID) ---
# Tenant ID (GUID publico del tenant). Se arma la URL del issuer en
# application.properties: https://login.microsoftonline.com/${AZURE_TENANT_ID}/v2.0
AZURE_TENANT_ID=e34a6311-e69d-4a97-bedf-2ad7cc5455a0

# El frontend (React/MSAL) NO lee .env: su configuracion esta hardcodeada en
# Frontend/src/utils/enviroment.ts (clientId, tenantId, redirectUri y puertos).
